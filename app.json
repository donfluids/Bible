{
  "expo": {
    "name": "Bible",
    "slug": "bible",
    "version": "0.2.4",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/db/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F4EFE4",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#15130F"
          }
        }
      ],
      "./plugins/withAndroidRelease"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {}
  }
}
